# ---- Fashionist storefront (Vite) ----
# Copy to .env (local) — on Vercel add the same keys under Project → Settings → Environment Variables.

# true  = run fully in the browser with built-in demo data (no backend needed). Good for previews/demos.
# false = talk to the real Express API below.
VITE_USE_MOCK=true

# Base URL of the API, including /api. Local: http://localhost:5000/api · Render: https://fashionist-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Mock mode only: set true to try the email-OTP sign-up flow (the code is shown in a toast).
VITE_MOCK_EMAIL_VERIFICATION=false
