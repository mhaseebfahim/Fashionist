# ---------------- Fashionist API ----------------
# Copy to server/.env for local runs. On Render/Railway add the same keys in the dashboard.

PORT=5000
NODE_ENV=development

# MongoDB — must be a REPLICA SET (transactions). Atlas clusters are replica sets by default.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fashionist?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fashionist?retryWrites=true&w=majority

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Storefront origin(s) allowed by CORS, comma separated, no trailing slash.
CLIENT_URL=http://localhost:5173,https://fashionist.store,https://www.fashionist.store

# Public website URL — used in password-reset links and the sitemap.
SITE_URL=https://fashionist.store

# The ONE store admin, created/updated by `npm run seed`.
ADMIN_EMAIL=youradmin@gmail.com
ADMIN_PASSWORD=<strong password: 12+ chars, upper, lower, number, symbol>

# ---- Sign-up rules ----
# Email OTP verification. Keep false until an email provider below works, then set true.
EMAIL_VERIFICATION_ENABLED=false
# Only these domains may register (exact match after @).
ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com

# ---- Email delivery: console | resend | smtp ----
# console = only logs emails (default). resend = Resend API. smtp = Nodemailer (Gmail app password, Brevo, Mailgun…)
EMAIL_PROVIDER=console
MAIL_FROM="Fashionist <no-reply@fashionist.store>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Cloudinary (product & CMS image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Google sign-in (optional). Leave empty to hide the button. ----
GOOGLE_CLIENT_ID=


